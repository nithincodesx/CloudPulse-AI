SUPABASE_URL=https://your-project.supabase.co
# Service-role key — bypasses RLS; backend-only, NEVER expose to the frontend.
# Find it under Settings → API → service_role.
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# REQUIRED for dashboard login to work: the secret Supabase uses to sign
# user access tokens. The backend verifies every dashboard request's JWT
# with it and fails closed (all dashboard calls 401) when it is missing.
# Find it under Supabase → Settings → API → JWT Settings → JWT Secret.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Clock-skew leeway (seconds) allowed when verifying JWT expiry.
SUPABASE_JWT_LEEWAY_SECONDS=30

# Comma-separated list of allowed frontend origins (CORS).
CORS_ORIGINS=http://localhost:3000

# Rate limit for POST /api/metrics (per client IP).
RATE_LIMIT_PER_MINUTE=30

# Log verbosity for structured logging (DEBUG | INFO | WARNING | ERROR).
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Optional: AWS Cost Explorer (real cost data)
# Leave all AWS vars empty/unset to run in simulated mode (cost shows $0 with
# a "Simulated cost mode" prompt until a cloud account is connected).
# ---------------------------------------------------------------------------
# IAM read-only creds with Cost Explorer access (AWSBillingReadOnlyAccess or
# ce:GetCostAndUsage). Keep these in backend/.env — never in the frontend.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Region is cosmetic for Cost Explorer (global); default us-east-1.
AWS_REGION=us-east-1
# Resource-tag key used to attribute spend per node (must match your AWS tags).
AWS_COST_TAG_KEY=server
# Your CloudPulse AWS account id, shown in the dashboard's AWS connection
# wizard as the account the customer's IAM role must trust (cross-account
# STS AssumeRole flow). Leave empty until you run a central CloudPulse
# account; per-tenant connections created in the UI do not need it.
CLOUDPULSE_AWS_ACCOUNT_ID=
# How often (minutes) the background AWS discovery sync runs when enabled.
AWS_DISCOVERY_INTERVAL_MINUTES=30

# ---------------------------------------------------------------------------
# Optional: statistical anomaly detection (rolling baseline, NOT ML)
# Replaces the old hardcoded cutoffs. A server needs BASELINE_MIN_SAMPLES points
# in the rolling window before any z-score claim is made.
# ---------------------------------------------------------------------------
ANOMALY_Z_SCORE=3.0
NETWORK_Z_SCORE=4.0
BASELINE_DAYS=7
BASELINE_MIN_SAMPLES=10
# Idle is an absolute low-utilization floor (not an anomaly): cpu below IDLE_CPU_FLOOR
# AND ram below IDLE_RAM_FLOOR.
IDLE_CPU_FLOOR=5.0
IDLE_RAM_FLOOR=10.0
IDLE_NET_FLOOR=0.5
# Advanced detection tuning (values shown are the built-in defaults).
PEGGED_CPU_CEILING=95.0
CONSECUTIVE_ANOMALY_THRESHOLD=3
TIME_AWARE_MIN_SAMPLES=3
# Notification engine: default cooldown (minutes) between repeat alerts.
ALERT_COOLDOWN_MINUTES=15

# ---------------------------------------------------------------------------
# Optional: weekly AI summary (free-tier LLM — Groq or Gemini)
# The scheduled weekly job summarizes real alerts + cost deltas in plain
# English. The LLM never invents numbers; it only summarizes real data.
# Leave AI_PROVIDER/keys empty to disable the summary (anomaly detection
# still works). Get keys from console.groq.com or ai.google.dev (free tier).
# ---------------------------------------------------------------------------
# groq | gemini | auto (auto = Groq if GROQ_API_KEY set, else Gemini).
AI_PROVIDER=auto
GROQ_API_KEY=
GEMINI_API_KEY=
# Per-provider default if unset: gemini-2.5-flash / llama-3.1-8b-instant.
AI_MODEL=
# Cron schedule for the weekly job (APScheduler).
WEEKLY_INSIGHT_DOW=mon
WEEKLY_INSIGHT_HOUR=9
WEEKLY_INSIGHT_MINUTE=0
WEEKLY_INSIGHT_TZ=UTC

# ---------------------------------------------------------------------------
# Optional: email notification channel (SMTP)
# Used only when an email notification channel is configured in the UI.
# Leave empty to disable email delivery (webhook channels still work).
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alerts@cloudpulse.ai
