SUPABASE_URL=https://your-project.supabase.co
# Service-role key — bypasses RLS; backend-only, NEVER expose to the frontend.
# Find it under Settings → API → service_role.
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Comma-separated list of allowed frontend origins (CORS).
CORS_ORIGINS=http://localhost:3000

# Rate limit for POST /api/metrics (per client IP).
RATE_LIMIT_PER_MINUTE=30

# ---------------------------------------------------------------------------
# Optional: AWS Cost Explorer (real cost data)
# Leave all AWS vars empty/unset to run in simulated mode (cost shows $0 with
# a "Simulated cost mode" prompt until a cloud account is connected).
# ---------------------------------------------------------------------------
# IAM read-only creds with Cost Explorer access (AWSBillingReadOnlyAccess or
# ce:GetCostAndUsage). Keep these in backend/.env — never in the frontend.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Region is cosmetic for Cost Explorer (global); default us-east-1.
AWS_REGION=us-east-1
# Resource-tag key used to attribute spend per node (must match your AWS tags).
AWS_COST_TAG_KEY=server
